        <name>TDFD_enhancedCardWrapper</name>
        <uuid>_a-0000ef6f-de90-8000-9bf3-011c48011c48_885074</uuid>
        <description>Wrapper interface to use cards and labels</description>
        <parentUuid>83e2dedf-eebb-4919-a743-746bec7d52b9</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  local!isCollapsed: or(ri!isInitiallyCollapsed),
  {
    #"SYSTEM_SYSRULES_columnsLayout"(
      columns: {
        #"SYSTEM_SYSRULES_columnLayout"(
          contents: {
            #"SYSTEM_SYSRULES_richTextDisplayField"(
              showWhen: and(a!isNotNullOrEmpty(value: ri!label), ri!showWhen),
              value: {        
                #"SYSTEM_SYSRULES_richTextItem_v1"(
                  text: {
                    if(
                      or(ri!isCollapsible),
                      {
                        #"SYSTEM_SYSRULES_richTextIcon"(
                          icon: if(
                            local!isCollapsed,
                            "chevron-right",
                            "chevron-down",
                          ),
                        ),
                        " "
                      },
                      {}
                    ),
                    upper(ri!label),
                  },
                  color: a!defaultValue(value: ri!labelColor, default: "SECONDARY"),
                  size: "MEDIUM",
                  style: "STRONG",
                  linkStyle: "STANDALONE",
                  link: #"SYSTEM_SYSRULES_dynamicLink"(
                    showWhen: or(ri!isCollapsible),
                    value: not(local!isCollapsed),
                    saveInto: local!isCollapsed
                  )
                ),
                if(
                  a!isNullOrEmpty(ri!helpToolTip),
                  {},
                  {
                    #"SYSTEM_SYSRULES_richTextItem_v1"(
                      text: " "
                    ),
                    #"SYSTEM_SYSRULES_richTextIcon"(
                      icon: "question-circle",
                      altText: ri!helpToolTip,
                      caption: ri!helpToolTip,
                      color: "ACCENT"
                    )
                  }
                )

              },
              labelPosition: "COLLAPSED"
            ),
          }
        ),
        #"SYSTEM_SYSRULES_columnLayout"(
          contents: ri!secondaryAction,
          width: "AUTO",
          showWhen: a!isNotNullOrEmpty(ri!secondaryAction)
        )
      },
      marginBelow: "EVEN_LESS",
      showWhen: and(a!isNotNullOrEmpty(value: ri!label), ri!showWhen)
    ),
    #"SYSTEM_SYSRULES_cardLayout"(
      showWhen: and(
        ri!showWhen,
        ri!isCollapsible,
        not(local!isCollapsed)
      ),
      showBorder: a!defaultValue(
        value: ri!showBorder,
        default: true
      ),
        showShadow: a!defaultValue(
          value: ri!showShadow,
          default: false
        ),
          height: ri!height,
          shape: "SEMI_ROUNDED",
          contents: { ri!contents },
          marginBelow: a!defaultValue(ri!marginBelow,"STANDARD"),
          padding: ri!padding,
          style: ri!style,
          decorativeBarColor: ri!decorativeBarColor,
          decorativeBarPosition: ri!decorativeBarPosition,
          link: ri!link
    )
  }
)</definition>
